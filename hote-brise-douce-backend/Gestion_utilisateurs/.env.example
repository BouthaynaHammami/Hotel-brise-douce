# ============================================================
# Gestion_Utilisateurs — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
#
# These values MUST match the API Gateway configuration:
#   API_Gateway/src/main/resources/application.properties
#     spring.security.oauth2.resourceserver.jwt.issuer-uri=http://localhost:8080/realms/Hotel_Realm
# ============================================================

# Keycloak server base URL (no trailing slash)
KEYCLOAK_BASE_URL=http://localhost:8080

# Realm name — MUST match the realm in the Gateway's issuer-uri
KEYCLOAK_REALM=Hotel_Realm

# Admin REST API credentials (used to create users via Admin API)
# The "admin-cli" client uses password grant by default (no secret needed)
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_CLIENT_SECRET=

# Keycloak admin username and password (master realm admin account)
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
